# URL base del backend (incluye /api). Copiar a .env y ajustar según el entorno:
# - Android emulator: http://10.0.2.2:8000/api
# - iOS simulator / Expo web: http://127.0.0.1:8000/api
# - Physical phone (misma red): IP LAN del servidor, ej. http://192.168.1.20:8000/api
# - Producción: URL real del backend, ej. https://<tu-dominio-backend>/api
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api
