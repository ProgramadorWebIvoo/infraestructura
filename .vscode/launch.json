{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Listen for Xdebug (Laravel Backend)",
      "type": "php",
      "request": "launch",
      "port": 8000,
      "pathMappings": {
        "/var/www/html": "${workspaceFolder}"
      }
    },
    {
      "name": "Launch Chrome (React Frontend)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/src",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "webpack:///src/*": "${webRoot}/*"
      }
    }
  ]
}