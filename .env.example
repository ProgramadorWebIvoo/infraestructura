# URL del backend Laravel (incluye /api). En dev normalmente apunta a
# php artisan serve o Laravel Herd; en producción, al dominio real del backend.
VITE_API_URL=http://localhost:8000/api

# Laravel Reverb (WebSocket): notificaciones push instantáneas en vez de
# polling. Deben coincidir con REVERB_APP_KEY/HOST/PORT/SCHEME del backend.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
