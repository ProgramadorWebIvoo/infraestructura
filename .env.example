# URL del backend Laravel (incluye /api). En dev normalmente apunta a
# php artisan serve o Laravel Herd; en producción, al dominio real del backend.
VITE_API_URL=http://localhost:8000/api

# Pusher Channels (WebSocket): notificaciones push instantáneas en vez de
# polling. Deben coincidir con PUSHER_APP_KEY/PUSHER_APP_CLUSTER del backend.
VITE_PUSHER_APP_KEY=
VITE_PUSHER_APP_CLUSTER=mt1
